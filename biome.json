{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/coverage",
			"!**/*.md",
			"!**/skills-lock.json",
			"!**/.agents",
			"!**/.claude"
		]
	},
	"formatter": { "indentStyle": "tab", "lineWidth": 100 },
	"javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "double" } },
	"linter": {
		"enabled": true,
		"rules": {
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 10 }
				},
				"useLiteralKeys": "off"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": { "maxLines": 100, "skipBlankLines": true }
				},
				"noNonNullAssertion": "off",
				"useImportType": "error",
				"useExportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noImplicitAnyLet": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noExcessiveLinesPerFile": {
							"level": "error",
							"options": { "maxLines": 200, "skipBlankLines": true }
						}
					}
				}
			}
		}
	],
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
